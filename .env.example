# ==============================================================================
# Tour Designer v2 — Environment Configuration
# Copy to backend/.env for local overrides, or set on Cloud Run / Docker.
# All values have safe zero-config local defaults (SQLite + local file vault).
# ==============================================================================

ENV=local
APP_NAME=tour-designer

# --- Hosting Mode & Subpath ---
# "single" for a private team workspace (e.g. td.yourdomain.com)
# "multi" for a public SaaS instance with isolated workspaces per Google account
TENANCY_MODE=single
BASE_PATH=
PUBLIC_ORIGIN=

# --- Google OAuth 2.0 / OIDC (Sign Up & Sign In with Google) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Hosted Fair-Use Quotas & AI Cost Guardrails (enforced in TENANCY_MODE=multi; 0 = unlimited) ---
# Public Free Beta hardlocks hosted AI to HOSTED_AI_MODEL (gemini-4-hydrogen w/ thinkingLevel=low)
# unless a tenant supplies their own BYOK Gemini, Anthropic, or OpenAI API key in Settings.
HOSTED_PLAN_NAME=Free Beta
HOSTED_AI_MODEL=gemini-4-hydrogen
HOSTED_AI_THINKING_LEVEL=low
HOSTED_AI_DAILY_LIMIT=20
HOSTED_AI_MAX_INPUT_CHARS=12000
HOSTED_AI_MAX_OUTPUT_TOKENS=2048
HOSTED_MAX_GIGS=200
HOSTED_MAX_FILES_MB=250

# --- Community Share & Optional Bitcoin Tip Jar (active automatically in TENANCY_MODE=multi) ---
# After COMMUNITY_SHARE_MILESTONE_GIGS (default 7), shows a one-time confetti thank-you & share card.
# Leave BITCOIN_DONATION_ADDRESS blank to hide the tip jar completely.
COMMUNITY_SHARE_ENABLED=true
COMMUNITY_SHARE_MILESTONE_GIGS=7
COMMUNITY_SHARE_URL=
BITCOIN_DONATION_ADDRESS=
BITCOIN_LIGHTNING_ADDRESS=

# --- Legal & Privacy Notice (US CCPA/CPRA/COPPA & Mexico LFPDPPP/ARCO) ---
LEGAL_OPERATOR_NAME=Tour Designer
LEGAL_CONTACT_EMAIL=privacy@example.com
LEGAL_OPERATOR_ADDRESS=United States & Mexico
LEGAL_EFFECTIVE_DATE=2026-11-25

# --- Storage Backend ---
# "sqlite" for zero-config local dev / self-hosted single node
# "firestore" for stateless GCP Cloud Run (Always-Free Native Mode)
REPO_BACKEND=sqlite
LOCAL_DB_PATH=data/tour-designer-v2.sqlite3
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)
FIRESTORE_PREFIX=

# --- Authentication & Identity ---
# Leave BASIC_AUTH_PASSWORD empty for open local dev on loopback.
# Set a strong password before exposing publicly.
BASIC_AUTH_USER=owner
BASIC_AUTH_PASSWORD=
OWNER_NAME=Tour Manager
OWNER_EMAIL=owner@example.com
ARTIST_NAME=
CORS_ORIGINS=

# --- File Vault ---
# "local" writes to FILE_VAULT_LOCAL_PATH; "gcs" uses Direct V4 Signed URLs.
FILE_STORAGE_BACKEND=local
FILE_VAULT_LOCAL_PATH=data/vault
FILE_VAULT_BUCKET=
DRIVE_ROOT_FOLDER_ID=
DRIVE_MIRROR_ENABLED=false

# --- AI Intake: Google Workspace/Gemini, Anthropic (Sonnet 5.5+), OpenAI (Astra+) ---
# Connect Google Vertex AI, Gemini API, Anthropic API, or OpenAI API (live model list auto-updates once a key is set).
# Leave all empty to run 100% offline with the deterministic local parser.
# Owners can refresh live catalogs & switch models anytime in /settings.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-4-hydrogen
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional Integrations & Model Deprecation Watchdog ---
FLIGHTAWARE_API_KEY=
AERODATABOX_API_KEY=
DIGEST_CRON_TOKEN=
# Trigger POST /api/cron/check-ai-model (header: X-Cron-Token) weekly to email/webhook if a model is deprecated
MODEL_ALERT_EMAIL=
MODEL_ALERT_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PUBLIC_RECIPIENTS_TOKEN=
PUBLIC_GIGS_URL=
ARTIST_DIGEST_EMAIL=
CALENDAR_SYNC_CALENDAR_ID=
